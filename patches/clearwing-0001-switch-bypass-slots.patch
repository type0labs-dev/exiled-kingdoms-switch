+	/** Highest bypass slot written by any jump, looking inside optimized instruction groups. */
+	private static int maxBypassSlot(java.util.List<com.thelogicmaster.clearwing.bytecode.Instruction> instructions) {
+		int m = -1;
+		for (com.thelogicmaster.clearwing.bytecode.Instruction ins : instructions) {
+			if (ins instanceof InstructionGroup g) m = Math.max(m, maxBypassSlot(g.getInstructions()));
+			else if (ins instanceof com.thelogicmaster.clearwing.bytecode.SwitchInstruction sw) m = Math.max(m, sw.getMaxBypass());
+			else if (ins instanceof com.thelogicmaster.clearwing.bytecode.JumpInstruction j) m = Math.max(m, j.getBypass());
+		}
+		return m;
+	}
