+// An object's monitor is created on first use (synchronized/wait/notify): allocating one per object doubled the
+// malloc/free traffic, and almost none is ever used
+extern "C" jmonitor getObjectMonitor(jobject object) {
+    auto monitor = __atomic_load_n(&object->monitor, __ATOMIC_ACQUIRE);
+    if (monitor)
+        return (jmonitor) monitor;
+    auto created = new ObjectMonitor;
+    decltype(monitor) expected = 0;
+    if (__atomic_compare_exchange_n(&object->monitor, &expected, (decltype(monitor)) created, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        heapUsage += (int64_t) sizeof(ObjectMonitor);
+        return created;
+    }
+    delete created; // another thread won
+    return (jmonitor) expected;
+}
+
+// Collected objects are freed by the allocating threads, a few per allocation (sweepPending), not by the collection
+// thread: on the Switch both threads fought over newlib's malloc lock and every GC left seconds of 4 fps behind it.
+// The collection thread only runs the finalizers that may run Java code or take locks, then queues here.
+static std::vector<jobject> pendingFree; // guarded by objectsLock
+static constexpr int SWEEP_PER_ALLOCATION = 8;
+
+// Finalizers that only release native memory: run inline by the sweep
+static bool memoryOnlyFinalizer(jobject obj) {
+    auto finalizer = ((void **) obj->vtable)[VTABLE_java_lang_Object_finalize];
+    return finalizer == (void *) M_java_lang_Object_finalize || finalizer == (void *) array_finalize
+           || finalizer == (void *) M_java_lang_String_finalize;
+}
+
+/// Frees objects taken off pendingFree (already erased from `objects`). Called without objectsLock.
+static void freeObjects(jcontext ctx, jobject *batch, int count) {
+    for (int i = 0; i < count; i++) {
+        jobject obj = batch[i];
+        auto finalizer = ((void **) obj->vtable)[VTABLE_java_lang_Object_finalize];
+        if (finalizer == (void *) array_finalize || finalizer == (void *) M_java_lang_String_finalize)
+            ((finalizer_ptr) finalizer)(ctx, obj);
+        if (obj->monitor) {
+            delete (ObjectMonitor *) obj->monitor;
+            heapUsage -= (int64_t) sizeof(ObjectMonitor);
+        }
+        memset(obj, 0, sizeof(java_lang_Object)); // Erase collected objects to make memory bugs easier to catch
+        obj->gcMark = GC_MARK_COLLECTED;
+        delete[] (char *) obj;
+    }
+}
+
+/// Pops up to `count` pending objects and erases them from `objects`. Caller holds objectsLock.
+static int takePending(jobject *batch, int count) {
+    int n = 0;
+    while (n < count && !pendingFree.empty()) {
+        jobject obj = pendingFree.back();
+        pendingFree.pop_back();
+        objects->erase(obj);
+        heapUsage -= ((jclass) obj->clazz)->size;
+        batch[n++] = obj;
+    }
+    return n;
+}
