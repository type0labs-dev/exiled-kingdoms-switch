 /// Creates a new context. Does not throw exceptions.
+// ponytail: sampling profiler for the console (no perf there). With a "prof" file in the working dir, the GC's
+// collection thread (awake every ms; a thread of its own hung the boot on the Switch) reads the main thread's shadow
+// stack and appends to prof.log, every 10 s, the methods most often on top (self) and the top caller->callee pairs.
+// Reads race the game thread on purpose: statistics only. FrameInfos are static data (the transpiler emits them
+// static), so a stale pointer still names some method.
+struct Sampler {
+    std::unordered_map<const char *, int> self, inclusive;
+    std::unordered_map<std::string, int> pairs;
+    int samples = 0;
+    std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+
+    static bool plausible(const FrameInfo *info) {
+        auto anchor = (uintptr_t) &suspendVM; // static data of the binary: FrameInfos live near it, thread stacks don't
+        auto a = (uintptr_t) info;
+        return info && (a > anchor ? a - anchor : anchor - a) < (1ull << 30);
+    }
+
+    void sample(jcontext main) {
+        int depth = main->stackDepth;
+        if (depth <= 0 || depth >= MAX_STACK_DEPTH)
+            return;
+        const FrameInfo *top = main->frames[depth - 1].info;
+        const FrameInfo *caller = depth > 1 ? main->frames[depth - 2].info : nullptr;
+        if (!plausible(top))
+            return;
+        self[top->method]++;
+        const char *seen[64]; // each method once per sample, even when recursive
+        int nSeen = 0;
+        for (int i = depth - 1; i >= 0 && nSeen < 64; i--) {
+            const FrameInfo *info = main->frames[i].info;
+            if (!plausible(info)) continue;
+            bool dup = false;
+            for (int j = 0; j < nSeen && !dup; j++) dup = seen[j] == info->method;
+            if (dup) continue;
+            seen[nSeen++] = info->method;
+            inclusive[info->method]++;
+        }
+        if (plausible(caller))
+            pairs[std::string(caller->method) + " -> " + top->method]++;
+        samples++;
+    }
+
+    void dumpIfDue() {
+        if (samples == 0 || std::chrono::steady_clock::now() - last < std::chrono::seconds(10))
+            return;
+        last = std::chrono::steady_clock::now();
+        std::vector<std::pair<int, std::string>> top, topPairs, topInclusive;
+        for (auto &pair : self) top.emplace_back(pair.second, pair.first);
+        for (auto &pair : inclusive) topInclusive.emplace_back(pair.second, pair.first);
+        for (auto &pair : pairs) topPairs.emplace_back(pair.second, pair.first);
+        auto byCount = [](auto &a, auto &b) { return a.first > b.first; };
+        std::sort(top.begin(), top.end(), byCount);
+        std::sort(topPairs.begin(), topPairs.end(), byCount);
+        std::sort(topInclusive.begin(), topInclusive.end(), byCount);
+        if (FILE *f = fopen("prof.log", "a")) {
+            fprintf(f, "== %lld: %d samples\n", (long long) std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::system_clock::now().time_since_epoch()).count(), samples);
+            for (int i = 0; i < (int) top.size() && i < 25; i++)
+                fprintf(f, "  %5.1f%% %s\n", 100.0 * top[i].first / samples, top[i].second.c_str());
+            fprintf(f, "  inclusive:\n");
+            for (int i = 0; i < (int) topInclusive.size() && i < 40; i++)
+                fprintf(f, "  %5.1f%% %s\n", 100.0 * topInclusive[i].first / samples, topInclusive[i].second.c_str());
+            fprintf(f, "  callers:\n");
+            for (int i = 0; i < (int) topPairs.size() && i < 15; i++)
+                fprintf(f, "  %5.1f%% %s\n", 100.0 * topPairs[i].first / samples, topPairs[i].second.c_str());
+            fclose(f);
+        }
+        self.clear();
+        inclusive.clear();
+        pairs.clear();
+        samples = 0;
+    }
+};
